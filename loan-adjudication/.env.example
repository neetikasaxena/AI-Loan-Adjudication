# Copy to .env (git-ignored) and fill in. Leave LLM_BASE_URL empty to run fully offline
# (regex extractor + template explainer).

# OpenAI-compatible chat-completions endpoint (e.g. your internal LLM gateway base URL)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Header that carries the key. "Authorization" sends "Bearer <key>"; any other header sends the raw key.
LLM_API_KEY_HEADER=Authorization
# Optional JSON object of extra headers required by the gateway, e.g. {"X-Consumer-Id": "..."}
LLM_EXTRA_HEADERS={}
# Optional path to a corporate CA bundle for TLS verification
LLM_CA_BUNDLE=
LLM_TIMEOUT=60
# Set to false if the gateway rejects response_format={"type": "json_object"}
LLM_JSON_MODE=true
